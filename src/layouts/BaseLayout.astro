---
import '../styles/global.css';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { langCodes } from '../i18n/ui';
import {
	getLangFromUrl,
	localizePath,
	stripLangFromPath,
	useTranslations,
} from '../i18n/utils';

interface Props {
	/** Falls back to the site title from the dictionary. */
	title?: string;
	/** Falls back to the site description from the dictionary. */
	description?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { title = t('site.title'), description = t('site.description') } = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const pathWithoutLang = stripLangFromPath(Astro.url.pathname);
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />

		{
			langCodes.map((code) => (
				<link
					rel="alternate"
					hreflang={code}
					href={new URL(localizePath(pathWithoutLang, code), Astro.site)}
				/>
			))
		}

		{/* Visitors arrive from links (Steam, itch, Discord), so the preview card
		    matters more than search ranking. */}
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta name="twitter:card" content="summary_large_image" />
		{/* TODO: add og:image (1200x630, absolute URL) before sharing links publicly. */}
	</head>
	<body>
		<div class="language-corner">
			<LanguageSwitcher />
		</div>
		<slot />
	</body>
</html>

<style>
	body {
		position: relative;
	}

	/* Top-right corner, lined up with the container's own side padding. */
	.language-corner {
		position: absolute;
		inset-block-start: var(--space-6);
		inset-inline-end: var(--container-padding-inline);
	}
</style>
